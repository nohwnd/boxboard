<Window x:Class="Boxboard.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Boxboard - live log" Icon="/Boxboard;component/Assets/Boxboard.ico"
        Width="1000" Height="500" MinWidth="500" MinHeight="250"
        Background="#F4F6F9" FontFamily="Segoe UI" FontSize="13">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,10" TextWrapping="Wrap"
                   Text="Live activity (last 300 entries, memory only). Move this window to your other monitor. Client-window presence does not prove an authenticated remote connection." />
        <ListBox x:Name="LogList" ItemsSource="{Binding Entries}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingStackPanel.IsVirtualizing="False">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="4,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Time, StringFormat=HH:mm:ss.fff}" Foreground="#46556A" />
                        <TextBlock Grid.Column="1" Text="{Binding Context}" TextWrapping="Wrap" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
